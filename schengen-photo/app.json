{
  "expo": {
    "name": "Schengen Photo",
    "slug": "schengen-photo",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mifarosa.schengenphoto",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take your visa photo.",
        "NSPhotoLibraryUsageDescription": "Used to pick a photo for your visa picture."
      }
    },
    "android": { "package": "com.mifarosa.schengenphoto" },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-image-picker",
      "expo-sharing"
    ]
  }
}
